{
  "doctype": "DocType",
  "name": "UniCom Issue Event",
  "module": "UniCom",
  "engine": "InnoDB",
  "field_order": [
    "kind",
    "actor",
    "recorded_at",
    "happened_at",
    "channel",
    "contact",
    "body",
    "changes",
    "reply_to",
    "source_comment",
    "follow_up_action",
    "follow_up_date",
    "schedule_type",
    "scheduled_time",
    "completed_at",
    "scheduled_for"
  ],
  "fields": [
    {
      "fieldname": "kind",
      "label": "Kind",
      "fieldtype": "Select",
      "options": "Created\nUpdated\nCommunication\nResolved\nReopened\nComment\nScheduled",
      "reqd": 1
    },
    {
      "fieldname": "actor",
      "label": "Actor",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "recorded_at",
      "label": "Recorded At",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "fieldname": "happened_at",
      "label": "Happened At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "channel",
      "label": "Channel",
      "fieldtype": "Select",
      "options": "\nInternal Note\nCall\nMeeting\nEmail\nWhatsApp"
    },
    {
      "fieldname": "contact",
      "label": "Contact / Person",
      "fieldtype": "Data"
    },
    {
      "fieldname": "body",
      "label": "Outcome / Body",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "changes",
      "label": "Changes",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "reply_to",
      "label": "Reply To",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "source_comment",
      "label": "Source comment",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "follow_up_action",
      "label": "Follow-up action",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "follow_up_date",
      "label": "Follow-up date",
      "fieldtype": "Date",
      "read_only": 1
    },
    {
      "fieldname": "schedule_type",
      "label": "Schedule type",
      "fieldtype": "Select",
      "options": "\nMeeting\nFollow-up",
      "read_only": 1
    },
    {
      "fieldname": "scheduled_time",
      "label": "Scheduled time",
      "fieldtype": "Time",
      "read_only": 1
    },
    {
      "fieldname": "completed_at",
      "label": "Completed at",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "scheduled_for",
      "label": "Scheduled for",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    }
  ],
  "istable": 1
}
